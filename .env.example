# Servidor
PORT=3000
NODE_ENV=development

# MongoDB (local o Atlas)
# Local:  mongodb://localhost:27017/mis-guardias
# Atlas:  mongodb+srv://USUARIO:PASS@cluster.mongodb.net/mis-guardias
MONGODB_URI=mongodb://localhost:27017/mis-guardias

# JWT
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=30d

# CORS (origenes permitidos separados por coma). En dev alcanza con Expo.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Admin inicial (lo crea el script "npm run seed")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-en-primer-login
ADMIN_NAME=Admin
ADMIN_LASTNAME=General
ADMIN_SECTOR=Administracion
